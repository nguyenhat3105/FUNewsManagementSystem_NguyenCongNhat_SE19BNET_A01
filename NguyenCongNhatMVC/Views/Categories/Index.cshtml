@model IEnumerable<Category>
@{
    ViewData["Title"] = "Categories";
}

<partial name="_Alerts" />

<div class="page-header">
    <div>
        <h1 class="page-title">Categories</h1>
        <p class="page-subtitle">Organize news into structured categories.</p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <form method="get" class="search-form">
            <input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Search categories" />
            <button class="btn btn-outline-primary" type="submit">Search</button>
        </form>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#categoryModal" id="create-category-btn">
            + Create
        </button>
    </div>
</div>

<div class="table-container">
    <table class="table table-striped align-middle mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Parent</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="empty-state">
                        <p>No categories yet. Create your first category!</p>
                    </td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="strong-cell">@item.CategoryName</td>
                    <td class="muted-cell clipped-cell">
                        <span>@item.CategoryDescription</span>
                    </td>
                    <td>
                        @if (item.ParentCategory != null)
                        {
                            <span class="news-category">Parent: @item.ParentCategory.CategoryName</span>
                        }
                        else
                        {
                            <span class="muted-cell">Root</span>
                        }
                    </td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="status-active">Active</span>
                        }
                        else
                        {
                            <span class="status-inactive">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            <button class="btn btn-sm btn-outline-secondary edit-category"
                                    data-bs-toggle="modal" data-bs-target="#categoryModal"
                                    data-id="@item.CategoryID"
                                    data-name="@item.CategoryName"
                                    data-description="@item.CategoryDescription"
                                    data-parent="@item.ParentCategoryID"
                                    data-active="@item.IsActive.ToString().ToLower()">
                                Edit
                            </button>
                            <form asp-action="Delete" method="post" class="d-inline"
                                  data-confirm="This category will be permanently deleted."
                                  data-confirm-title="Delete category?"
                                  data-confirm-ok="Delete category"
                                  data-confirm-variant="danger">
                                <input type="hidden" name="id" value="@item.CategoryID" />
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Category Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Save" method="post" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="categoryModalTitle">Create Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="CategoryID" id="categoryId" />
                <div class="mb-3">
                    <label class="form-label">Category Name</label>
                    <input name="CategoryName" id="categoryName" class="form-control" required maxlength="100" placeholder="Enter category name..." />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea name="CategoryDescription" id="categoryDescription" class="form-control" required maxlength="250" rows="3" placeholder="Describe this category..."></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Parent Category</label>
                    <select name="ParentCategoryID" id="categoryParent" class="form-select" asp-items="ViewBag.ParentCategories">
                        <option value="">None (Root Category)</option>
                    </select>
                </div>
                <div class="form-check-panel">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="categoryActive" checked />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label" for="categoryActive">
                            Category is Active
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" id="categorySaveBtn">Save Category</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('.edit-category').forEach(button => {
    button.addEventListener('click', () => {
        document.getElementById('categoryModalTitle').textContent = 'Edit Category';
        document.getElementById('categorySaveBtn').textContent = 'Save Changes';
        document.getElementById('categoryId').value = button.dataset.id;
        document.getElementById('categoryName').value = button.dataset.name;
        document.getElementById('categoryDescription').value = button.dataset.description;
        document.getElementById('categoryParent').value = button.dataset.parent || '';
        document.getElementById('categoryActive').checked = button.dataset.active === 'true';
    });
});
document.getElementById('categoryModal').addEventListener('show.bs.modal', event => {
    if (!event.relatedTarget || !event.relatedTarget.classList.contains('edit-category')) {
        event.target.querySelector('form').reset();
        document.getElementById('categoryId').value = '';
        document.getElementById('categoryModalTitle').textContent = 'Create Category';
        document.getElementById('categorySaveBtn').textContent = 'Save Category';
    }
});
</script>
}
