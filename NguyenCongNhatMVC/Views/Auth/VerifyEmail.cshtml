@{
    ViewData["Title"] = "Verify email";
    Layout = "_Layout";
}

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-logo">
            <div class="login-logo-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="3" width="8" height="11" rx="1.5" fill="white" fill-opacity=".95"/>
                    <rect x="13" y="3" width="8" height="6" rx="1.5" fill="white" fill-opacity=".95"/>
                    <rect x="3" y="17" width="18" height="3" rx="1.5" fill="white" fill-opacity=".7"/>
                    <rect x="13" y="11" width="8" height="4" rx="1.5" fill="white" fill-opacity=".7"/>
                </svg>
            </div>
            <h1>Verify your email</h1>
            <p>Enter the 6-digit code sent to your email address.</p>
        </div>

        @if (TempData["Success"] is string message)
        {
            <div class="alert alert-success mb-3">@message</div>
        }

        @if (TempData["DemoEmailCode"] is string demoCode)
        {
            <div class="alert alert-info mb-3">
                Demo verification code: <strong>@demoCode</strong>
            </div>
        }

        <form asp-action="VerifyEmail" method="post" novalidate>
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger mb-3">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <div class="mb-4">
                <label for="code" class="form-label">Verification code</label>
                <input id="code"
                       name="code"
                       class="form-control text-center"
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       maxlength="6"
                       placeholder="123456" />
            </div>

            <button class="btn btn-primary w-100" type="submit">Verify and create account</button>
        </form>

        <div class="login-demo">
            <p>
                Need to change email?
                <a asp-action="Register" asp-controller="Auth">Register again</a>
            </p>
        </div>
    </div>
</div>
