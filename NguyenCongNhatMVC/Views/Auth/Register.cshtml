@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create account - FUNews</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        * { box-sizing: border-box; }
        html, body { min-height: 100%; }
        body {
            margin: 0;
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: #f3f6fb;
            color: #0f172a;
        }
        .register-shell {
            width: 100%;
            min-height: 100vh;
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(420px, .95fr);
            overflow: hidden;
        }
        .register-visual {
            position: relative;
            min-height: 100vh;
            padding: 32px;
            display: flex;
            align-items: stretch;
            background: #dbeafe;
            overflow: hidden;
        }
        .register-photo {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            opacity: .86;
            filter: saturate(1.05) contrast(1.02);
        }
        .register-visual::after {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(120deg, rgba(8, 15, 28, .84) 0%, rgba(15, 47, 87, .54) 45%, rgba(37, 99, 235, .16) 100%),
                radial-gradient(circle at 74% 18%, rgba(255, 255, 255, .22), transparent 34%);
        }
        .visual-content {
            position: relative;
            z-index: 1;
            width: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: #fff;
        }
        .brand-link {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: #fff;
            text-decoration: none;
            font-weight: 800;
            letter-spacing: 0;
        }
        .brand-mark {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            background: #1d4ed8;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 12px 28px rgba(29, 78, 216, .34);
        }
        .visual-copy {
            max-width: 560px;
            padding-bottom: 12px;
        }
        .visual-kicker {
            margin: 0 0 12px;
            color: rgba(219, 234, 254, .86);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .14em;
            text-transform: uppercase;
        }
        .visual-title {
            margin: 0;
            max-width: 620px;
            font-size: clamp(34px, 5.2vw, 64px);
            line-height: .98;
            font-weight: 900;
            letter-spacing: 0;
        }
        .visual-subtitle {
            margin: 18px 0 0;
            max-width: 500px;
            color: rgba(241, 245, 249, .82);
            font-size: 16px;
            line-height: 1.55;
        }
        .visual-card {
            width: min(390px, 78%);
            margin-top: 28px;
            padding: 16px;
            border-radius: 14px;
            background: rgba(255, 255, 255, .11);
            border: 1px solid rgba(255, 255, 255, .16);
            backdrop-filter: blur(12px);
        }
        .visual-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            color: rgba(226, 232, 240, .74);
            font-size: 12px;
            margin-bottom: 10px;
        }
        .visual-card-title {
            margin: 0;
            color: #fff;
            font-size: 16px;
            font-weight: 800;
            line-height: 1.35;
        }
        .visual-card-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 14px;
            color: rgba(226, 232, 240, .7);
            font-size: 12px;
        }
        .visual-avatar {
            width: 24px;
            height: 24px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #dbeafe;
            color: #1e40af;
            font-size: 11px;
            font-weight: 900;
        }
        .register-form-panel {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: #ffffff;
        }
        .register-form-inner { width: min(100%, 440px); }
        .mobile-brand {
            display: none;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
            color: #0f172a;
            text-decoration: none;
            font-weight: 800;
        }
        .form-heading {
            margin: 0;
            font-size: 28px;
            line-height: 1.1;
            font-weight: 900;
            letter-spacing: 0;
        }
        .form-subtitle {
            margin: 8px 0 18px;
            color: #64748b;
            font-size: 14px;
        }
        .compact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }
        .auth-field { margin-bottom: 12px; }
        .auth-label {
            display: block;
            margin-bottom: 5px;
            color: #0f172a;
            font-size: 12px;
            font-weight: 800;
        }
        .auth-label-opt { color: #94a3b8; font-weight: 600; }
        .auth-input {
            width: 100%;
            height: 40px;
            padding: 8px 12px;
            border: 1.5px solid #dbe3ef;
            border-radius: 8px;
            background: #f8fafc;
            color: #0f172a;
            font-size: 14px;
            outline: none;
            transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
        }
        .auth-input::placeholder { color: #9aa8b8; }
        .auth-input:focus {
            border-color: #2563eb;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
        }
        .field-error {
            display: block;
            margin-top: 4px;
            color: #dc2626;
            font-size: 11px;
            line-height: 1.25;
        }
        .auth-error {
            display: flex;
            gap: 8px;
            align-items: flex-start;
            margin-bottom: 12px;
            padding: 10px 12px;
            border: 1px solid #fecaca;
            border-radius: 8px;
            background: #fef2f2;
            color: #991b1b;
            font-size: 12px;
            line-height: 1.4;
        }
        .auth-btn {
            width: 100%;
            height: 42px;
            margin-top: 4px;
            border: 0;
            border-radius: 8px;
            background: #1d4ed8;
            color: #fff;
            font-size: 14px;
            font-weight: 800;
            transition: background .15s ease, transform .1s ease;
        }
        .auth-btn:hover { background: #1e40af; }
        .auth-btn:active { transform: translateY(1px); }
        .reg-footer {
            margin-top: 14px;
            text-align: center;
            color: #64748b;
            font-size: 13px;
        }
        .reg-footer a {
            color: #1d4ed8;
            text-decoration: none;
            font-weight: 800;
        }
        .reg-footer a:hover { text-decoration: underline; }
        @@media (max-width: 960px) {
            .register-shell { display: block; min-height: 100vh; overflow: auto; }
            .register-visual { display: none; }
            .register-form-panel { min-height: 100vh; padding: 22px 16px; }
            .mobile-brand { display: inline-flex; }
        }
        @@media (max-width: 520px) {
            .compact-grid { grid-template-columns: 1fr; gap: 0; }
            .form-heading { font-size: 24px; }
            .register-form-panel { align-items: flex-start; }
        }
        @@media (max-height: 720px) and (min-width: 961px) {
            .register-visual { padding: 24px; }
            .visual-title { font-size: 42px; }
            .visual-subtitle { margin-top: 12px; font-size: 14px; }
            .visual-card { margin-top: 18px; padding: 14px; }
            .form-heading { font-size: 24px; }
            .form-subtitle { margin-bottom: 12px; }
            .auth-field { margin-bottom: 9px; }
            .auth-input { height: 38px; }
            .auth-btn { height: 40px; }
            .reg-footer { margin-top: 10px; }
        }
    </style>
</head>
<body>
<main class="register-shell">
    <section class="register-visual" aria-hidden="true">
        <img src="~/images/campus-news-visual.svg" class="register-photo" alt="" />
        <div class="visual-content">
            <a class="brand-link" asp-controller="News" asp-action="Index">
                <span class="brand-mark">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                        <rect x="2" y="2" width="6" height="9" rx="1.5" fill="white" fill-opacity=".95"/>
                        <rect x="10" y="2" width="6" height="5" rx="1.5" fill="white" fill-opacity=".95"/>
                        <rect x="2" y="13" width="14" height="3" rx="1.5" fill="white" fill-opacity=".65"/>
                    </svg>
                </span>
                <span>FUNews</span>
            </a>

            <div class="visual-copy">
                <p class="visual-kicker">University News Management</p>
                <h1 class="visual-title">Join the campus newsroom.</h1>
                <p class="visual-subtitle">Create a reader account to follow official announcements, research updates, campus events, and student stories from FUNews.</p>

                <div class="visual-card">
                    <div class="visual-card-top">
                        <span>Featured today</span>
                        <span>Campus</span>
                    </div>
                    <p class="visual-card-title">Students publish new research stories through the FUNews editorial workflow.</p>
                    <div class="visual-card-meta">
                        <span class="visual-avatar">N</span>
                        <span>Nguyen Cong Nhat</span>
                        <span>•</span>
                        <span>5 min read</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="register-form-panel">
        <div class="register-form-inner">
            <a class="mobile-brand" asp-controller="News" asp-action="Index">
                <span class="brand-mark">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                        <rect x="2" y="2" width="6" height="9" rx="1.5" fill="white" fill-opacity=".95"/>
                        <rect x="10" y="2" width="6" height="5" rx="1.5" fill="white" fill-opacity=".95"/>
                        <rect x="2" y="13" width="14" height="3" rx="1.5" fill="white" fill-opacity=".65"/>
                    </svg>
                </span>
                <span>FUNews</span>
            </a>

            <h2 class="form-heading">Create account</h2>
            <p class="form-subtitle">Verify your email, then start reading FUNews.</p>

            <form asp-action="Register" asp-controller="Auth" method="post" id="register-form" novalidate>
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="auth-error">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="flex-shrink:0;margin-top:1px">
                            <circle cx="8" cy="8" r="7" stroke="#dc2626" stroke-width="1.5"/>
                            <path d="M8 5v3.5M8 10.5v.5" stroke="#dc2626" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        <span>
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors).Take(2))
                            {
                                @err.ErrorMessage
                                <br />
                            }
                        </span>
                    </div>
                }

                <div class="compact-grid">
                    <div class="auth-field">
                        <label asp-for="FullName" class="auth-label">Full name</label>
                        <input asp-for="FullName" class="auth-input" placeholder="Nguyen Van A" autocomplete="name" />
                        <span asp-validation-for="FullName" class="field-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="PhoneNumber" class="auth-label">
                            Phone <span class="auth-label-opt">(optional)</span>
                        </label>
                        <input asp-for="PhoneNumber" class="auth-input" placeholder="+84 xxx xxx xxx" autocomplete="tel" />
                        <span asp-validation-for="PhoneNumber" class="field-error"></span>
                    </div>
                </div>

                <div class="auth-field">
                    <label asp-for="Email" class="auth-label">Email address</label>
                    <input asp-for="Email" class="auth-input" placeholder="you@example.com" autocomplete="email" inputmode="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="compact-grid">
                    <div class="auth-field">
                        <label asp-for="Password" class="auth-label">Password</label>
                        <input asp-for="Password" class="auth-input" placeholder="Min. 6 characters" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="ConfirmPassword" class="auth-label">Confirm</label>
                        <input asp-for="ConfirmPassword" class="auth-input" placeholder="Repeat password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>
                </div>

                <button class="auth-btn" type="submit" id="register-btn">Continue with email</button>
            </form>

            <div class="reg-footer">
                Already have an account? <a asp-action="Login" asp-controller="Auth">Sign in</a>
            </div>
        </div>
    </section>
</main>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial" />
</body>
</html>
