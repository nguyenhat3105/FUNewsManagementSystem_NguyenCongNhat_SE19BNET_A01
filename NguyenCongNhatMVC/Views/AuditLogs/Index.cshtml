@model IEnumerable<AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Audit Logs</h1>
        <p class="page-subtitle">Recent user actions across management modules.</p>
    </div>
</div>

<div class="table-container">
    <table class="table table-striped align-middle mb-0">
        <thead>
            <tr>
                <th>Time</th>
                <th>User</th>
                <th>Role</th>
                <th>Action</th>
                <th>Entity</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="muted-cell">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td>@item.ActorEmail</td>
                <td>@item.ActorRole</td>
                <td><span class="badge text-bg-secondary">@item.Action</span></td>
                <td>@item.EntityName @item.EntityKey</td>
                <td class="muted-cell">@item.Description</td>
            </tr>
        }
        </tbody>
    </table>
</div>
