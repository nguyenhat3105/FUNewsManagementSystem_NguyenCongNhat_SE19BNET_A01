@model IEnumerable<SystemAccount>
@{
    ViewData["Title"] = "Accounts";
}

<partial name="_Alerts" />

<div class="page-header">
    <div>
        <h1 class="page-title">Accounts</h1>
        <p class="page-subtitle">Manage system users and roles.</p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <form method="get" class="search-form">
            <input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Search accounts" />
            <button class="btn btn-outline-primary" type="submit">Search</button>
        </form>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#accountModal" id="create-account-btn">
            + Create
        </button>
    </div>
</div>

<div class="table-container">
    <table class="table table-striped align-middle mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="empty-state">
                        <p>No accounts found.</p>
                    </td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="account-cell">
                            <div class="table-avatar">
                                @(item.AccountName?.Length > 0 ? item.AccountName[0].ToString().ToUpper() : "?")
                            </div>
                            <span>@item.AccountName</span>
                        </div>
                    </td>
                    <td class="muted-cell">@item.AccountEmail</td>
                    <td>
                        @{
                            var roleClass = item.RoleName switch {
                                "Admin" => "role-admin",
                                "Staff" => "role-staff",
                                _ => "role-reader"
                            };
                        }
                        <span class="role-pill @roleClass">
                            @item.RoleName
                        </span>
                    </td>
                    <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            <button class="btn btn-sm btn-outline-secondary edit-account"
                                    data-bs-toggle="modal" data-bs-target="#accountModal"
                                    data-id="@item.AccountID"
                                    data-name="@item.AccountName"
                                    data-email="@item.AccountEmail"
                                    data-role="@item.AccountRole"
                                    data-password="@item.AccountPassword">
                                Edit
                            </button>
                            <form asp-action="Delete" method="post" class="d-inline"
                                  data-confirm="This account will be permanently deleted."
                                  data-confirm-title="Delete account?"
                                  data-confirm-ok="Delete account"
                                  data-confirm-variant="danger">
                                <input type="hidden" name="id" value="@item.AccountID" />
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Account Modal -->
<div class="modal fade" id="accountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Save" method="post" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="accountModalTitle">Create Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="AccountID" id="accountId" />
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input name="AccountName" id="accountName" class="form-control" required maxlength="100" placeholder="Enter full name..." />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <input name="AccountEmail" id="accountEmail" class="form-control" type="email" required maxlength="100" placeholder="user@example.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Role</label>
                    <select name="AccountRole" id="accountRole" class="form-select">
                        <option value="1">Staff</option>
                        <option value="2">Lecturer</option>
                        <option value="3">Reader</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input name="AccountPassword" id="accountPassword" class="form-control" type="password" required minlength="6" maxlength="100" placeholder="Minimum 6 characters..." />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" id="accountSaveBtn">Save Account</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('.edit-account').forEach(button => {
    button.addEventListener('click', () => {
        document.getElementById('accountModalTitle').textContent = 'Edit Account';
        document.getElementById('accountSaveBtn').textContent = 'Save Changes';
        document.getElementById('accountId').value = button.dataset.id;
        document.getElementById('accountName').value = button.dataset.name;
        document.getElementById('accountEmail').value = button.dataset.email;
        document.getElementById('accountRole').value = button.dataset.role;
        document.getElementById('accountPassword').value = button.dataset.password;
    });
});
document.getElementById('accountModal').addEventListener('show.bs.modal', event => {
    if (!event.relatedTarget || !event.relatedTarget.classList.contains('edit-account')) {
        event.target.querySelector('form').reset();
        document.getElementById('accountId').value = '';
        document.getElementById('accountModalTitle').textContent = 'Create Account';
        document.getElementById('accountSaveBtn').textContent = 'Save Account';
    }
});
</script>
}
